{
  "name": "atl-video-editor",
  "version": "1.3.0",
  "description": "Agentic AI video editor — chat your edits into a real multi-track timeline",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "electron": "electron .",
    "mcp": "node mcp-server.mjs",
    "pack": "electron-builder",
    "dist": "electron-builder --publish=never",
    "test": "node --test tests/edl.test.mjs"
  },
  "keywords": [],
  "author": "ATL Video Editor <support@atlvideo.app>",
  "license": "ISC",
  "dependencies": {
    "@hyperframes/producer": "^0.7.90",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "hyperframes": "^0.7.90",
    "multer": "^2.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "com.aivideoeditor.app",
    "productName": "AI Video Editor",
    "icon": "build/icon.png",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "electron/**/*",
      "server.mjs",
      "server/**/*",
      "mcp-server.mjs",
      "public/**/*",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "asar": false,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Video"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
